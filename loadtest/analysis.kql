// =====================================================================
// Analyse du test de charge (Application Insights appi-mlpipe)
// Remplacer burst-163251 par l'identifiant affiché par loadtest/burst.sh
// =====================================================================

// L1. Synthèse de la rafale : fichiers traités, fenêtre de fin, latences, instances du worker
traces
| where timestamp > ago(1d) and message == "inference_done"
| extend f = tostring(customDimensions.fileName),
         d = todouble(customDimensions.durationMs),
         m = todouble(customDimensions.modelLatencyMs)
| where f startswith "burst-163251"
| summarize files = dcount(f), firstDone = min(timestamp), lastDone = max(timestamp),
            p50ms = percentile(d, 50), p95ms = percentile(d, 95), maxms = max(d),
            model50 = percentile(m, 50), model95 = percentile(m, 95),
            workers = dcount(cloud_RoleInstance)

// L2. Mise à l'échelle des Functions (Flex Consumption) pendant la rafale
requests
| where timestamp between (datetime(2026-11-24T15:32:50Z) .. datetime(2026-11-24T15:34:30Z))
| where cloud_RoleName == "func-mlpipe"
| summarize executions = count(), instances = dcount(cloud_RoleInstance), p95 = percentile(duration, 95) by operation_Name

// L3. Erreurs, doublons (idempotence) et reprises pendant la rafale
traces
| where timestamp between (datetime(2026-11-24T15:32:50Z) .. datetime(2026-11-24T15:40:00Z))
| where message in ("already_processed", "inference_failed", "superseded", "file_rejected")
| summarize count() by message

// L4. API sous charge Locust : latence côté serveur et réplicas
requests
| where timestamp between (datetime(2026-11-24T15:34:50Z) .. datetime(2026-11-24T15:36:00Z))
| where cloud_RoleName == "sentiment-api"
| summarize requests = count(), failed = countif(success == false),
            p50 = percentile(duration, 50), p95 = percentile(duration, 95), p99 = percentile(duration, 99),
            replicas = dcount(cloud_RoleInstance)

// L5. Débit de l'API par tranche de 10 s et par réplica
requests
| where timestamp between (datetime(2026-11-24T15:34:50Z) .. datetime(2026-11-24T15:36:00Z))
| where cloud_RoleName == "sentiment-api"
| summarize requests = count() by cloud_RoleInstance, bin(timestamp, 10s)
| render timechart
